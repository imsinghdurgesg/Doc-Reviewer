<?xml version="1.0" encoding="UTF-8"?>
<!--
  document-processing. Architecture §8.2.

  Produces the canonical document representation: nodes, evidence spans with hashes and bounding
  boxes, semantic chunks, rendered previews. Internal only — no browser-facing API.

  No spring-ai and no Qdrant: this service never embeds and never calls a model. Keeping those
  dependencies out is what makes that boundary enforceable rather than aspirational.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.app.docreview</groupId>
    <artifactId>document-standard-platform</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>document-processing</artifactId>
  <name>document-processing</name>

  <dependencies>
    <dependency>
      <groupId>com.app.docreview</groupId>
      <artifactId>platform-contracts</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-mongodb</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- Media-type detection and broad extraction. -->
    <dependency>
      <groupId>org.apache.tika</groupId>
      <artifactId>tika-core</artifactId>
    </dependency>
    <!-- PDF text with per-character coordinates; the source of bounding boxes for highlighting. -->
    <dependency>
      <groupId>org.apache.pdfbox</groupId>
      <artifactId>pdfbox</artifactId>
    </dependency>
    <!-- DOCX structure: real heading levels, which PDF cannot provide. -->
    <dependency>
      <groupId>org.apache.poi</groupId>
      <artifactId>poi-ooxml</artifactId>
    </dependency>

    <dependency>
      <groupId>io.minio</groupId>
      <artifactId>minio</artifactId>
    </dependency>

    <!--
      GCS: the same objects when running against Google Cloud (§41). Both adapters ship in the image
      and one is selected by `docreview.storage.provider`, so review-core and this worker can never
      disagree about where a document lives — which is exactly the failure that made every parse fail
      with NoSuchKey when only review-core had the GCS adapter.
    -->
    <dependency>
      <groupId>com.google.cloud</groupId>
      <artifactId>google-cloud-storage</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.app.docreview</groupId>
      <artifactId>platform-test-support</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
