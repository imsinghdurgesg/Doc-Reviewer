<?xml version="1.0" encoding="UTF-8"?>
<!--
  review-core. Architecture §8.1.

  The ONLY backend the browser talks to (§3). It owns standards, versions, comparisons, history,
  the repository-sync module, and job dispatch. It does NOT parse documents, embed, retrieve, or
  call a model — those belong to the two worker services.

  Note the absence of spring-ai: review-core must not hold a model client. Every model call goes
  through retrieval-comparison, which is the only service with LiteLLM credentials.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.app.docreview</groupId>
    <artifactId>document-standard-platform</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>review-core</artifactId>
  <name>review-core</name>

  <dependencies>
    <dependency>
      <groupId>com.app.docreview</groupId>
      <artifactId>platform-contracts</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-mongodb</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>

    <!--
      OIDC login for organizational SSO (§33). Active only under
      `docreview.security.mode=sso`; demo mode remains the default so local runs and the Compose
      stack need no identity provider.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-client</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-spring-boot4</artifactId>
    </dependency>

    <!-- MinIO: originals, rendered previews, extracted artifacts, exports (§23). -->
    <dependency>
      <groupId>io.minio</groupId>
      <artifactId>minio</artifactId>
    </dependency>

    <!--
      GCS: the same objects when running against Google Cloud (§41). Both adapters ship in the image
      and one is selected by `docreview.storage.provider`, so the deployment target is configuration
      rather than a separate build.
    -->
    <dependency>
      <groupId>com.google.cloud</groupId>
      <artifactId>google-cloud-storage</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      Job dispatch is HTTP (§9.2), and its central guarantee is an ORDERING one: the job record must
      be durable before the worker is called (§21). Only a real HTTP server lets a test observe what
      was persisted at the moment the request arrived, so WireMock is required here rather than a
      mocked RestClient.
    -->
    <dependency>
      <groupId>org.wiremock</groupId>
      <artifactId>wiremock-standalone</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.app.docreview</groupId>
      <artifactId>platform-test-support</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
