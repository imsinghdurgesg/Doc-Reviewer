{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "REQ-SCHEMA-V1",
  "description": "Protected response schema for requirement extraction. Architecture 12.5. Validated in Java after the provider's own structured-output pass, because provider structured output is best effort and this contract is not.",
  "type": "object",
  "additionalProperties": false,
  "required": ["requirements"],
  "properties": {
    "requirements": {
      "type": "array",
      "description": "May be empty. An empty list is the correct answer when the evidence supports no requirement (protected instruction 10).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirementId",
          "title",
          "sourceSpanIds",
          "normativeStrength",
          "normalizedRequirement",
          "atomicClauses",
          "extractionConfidence"
        ],
        "properties": {
          "requirementId": { "type": "string", "minLength": 1, "maxLength": 120 },
          "parentControlId": { "type": ["string", "null"], "maxLength": 120 },
          "sourceControlId": { "type": ["string", "null"], "maxLength": 120 },
          "title": { "type": "string", "minLength": 1, "maxLength": 300 },
          "sourceSpanIds": {
            "type": "array",
            "minItems": 1,
            "description": "At least one span is mandatory (12.8 rule 1): a requirement with no source is unciteable and unauditable.",
            "items": { "type": "string", "minLength": 1 }
          },
          "normativeStrength": {
            "type": "string",
            "enum": ["MANDATORY", "PROHIBITION", "CONDITIONAL", "ADVISORY", "DEFINITION", "EXAMPLE", "RATIONALE"]
          },
          "normalizedRequirement": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "atomicClauses": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["clauseId", "action", "negated"],
              "properties": {
                "clauseId": { "type": "string", "minLength": 1, "maxLength": 140 },
                "subject": { "type": ["string", "null"], "maxLength": 300 },
                "action": { "type": "string", "minLength": 1, "maxLength": 500 },
                "object": { "type": ["string", "null"], "maxLength": 500 },
                "timing": { "type": ["string", "null"], "maxLength": 300 },
                "condition": { "type": ["string", "null"], "maxLength": 500 },
                "negated": {
                  "type": "boolean",
                  "description": "Separate from action so a prohibition cannot be flattened into an obligation."
                }
              }
            }
          },
          "applicability": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "properties": {
              "documentTypes": { "type": "array", "items": { "type": "string" } },
              "conditions": { "type": "array", "items": { "type": "string" } }
            }
          },
          "expectedEvidenceHints": {
            "type": "array",
            "maxItems": 12,
            "items": { "type": "string", "maxLength": 200 }
          },
          "extractionConfidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
        }
      }
    }
  }
}
