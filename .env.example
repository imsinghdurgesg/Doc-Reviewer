# Architecture §30. Copy to .env and fill in. NEVER commit .env.
#
# LiteLLM is an EXISTING organizational service (§10) and is not deployed by this repository.
# §2 forbids the application calling OpenAI, Vertex, or Azure directly — every model and embedding
# call goes through the proxy.

# --- LiteLLM (§10.2) ---
# The proxy ROOT, without /v1: the OpenAI client appends /v1/chat/completions itself, so including
# /v1 here produces /v1/v1/... and a 404 that reads like a routing fault rather than a config one.
LITELLM_BASE_URL=https://litellm.example.internal
# Use a DEDICATED application virtual key, never a master key (§10.2, §10.5).
LITELLM_API_KEY=

# Stable application aliases (§10.1), configured in LiteLLM — never provider model names. Extraction
# and comparison may resolve to the same model today but stay independently versioned.
LITELLM_REQUIREMENT_EXTRACTION_MODEL=docreview-requirement-extractor
LITELLM_COMPARISON_MODEL=docreview-comparison
LITELLM_EMBEDDING_MODEL=docreview-embedding
LITELLM_RERANKER_MODEL=
LITELLM_TIMEOUT=60s
LITELLM_MAX_TOKENS=6000

# --- MongoDB (§22) ---
MONGODB_URI=mongodb://localhost:27017
MONGO_ROOT_USERNAME=docreview
MONGO_ROOT_PASSWORD=change-me

# --- Object storage (§23, §41) ---
# minio or gcs. Both adapters ship in the image; this selects which one is active, so moving to
# Google Cloud is configuration rather than a rebuild.
STORAGE_PROVIDER=minio

# --- MinIO (§23) ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=docreview
MINIO_ROOT_PASSWORD=change-me
MINIO_ACCESS_KEY=docreview
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=docreview

# --- Google Cloud Storage (§41) ---
# Only read when STORAGE_PROVIDER=gcs.
#
# AUTHENTICATION IS ADC — there is no key variable here on purpose. Use a workload identity or an
# attached service account in deployment; run `gcloud auth application-default login` locally. A
# downloaded service-account key is the credential most likely to be pasted into a ticket or baked
# into an image, so the adapter offers no way to supply one.
#
# Grant the service identity only what it needs on this bucket: objects.list and objects.get on the
# standards prefix, objects.create to write new versions.
GCP_PROJECT_ID=
GCS_BUCKET=
# The synced policy library. An object is read as <prefix>/<standard-key>/<version>/<filename>, so
# the path is what says which standard a file revises and which version it is.
GCS_STANDARDS_PREFIX=standards/

# How often the bucket is reconciled into the standards library. Each pass lists the prefix and
# ingests anything whose content hash is not already stored, so it is idempotent and a missed pass
# costs latency rather than data.
STANDARDS_SYNC_INTERVAL=PT5M
STANDARDS_SYNC_INITIAL_DELAY=PT1M

# --- Qdrant (§13.5) ---
QDRANT_HOST=localhost
QDRANT_PORT=6334
QDRANT_USE_TLS=false
QDRANT_API_KEY=

# --- Service URLs for internal job dispatch (§9.2) ---
DOCUMENT_PROCESSING_URL=http://localhost:8081
RETRIEVAL_COMPARISON_URL=http://localhost:8082

# --- Parsing safety limits (§14) ---
MAX_UPLOAD_SIZE=50MB
MAX_PAGE_COUNT=2000

# --- Internal service auth (§9.2, §30) ---
# Shared secret for review-core <-> worker calls. Workers refuse to start with this blank, because a
# blank token would leave the job surface unauthenticated. Use a long random value.
INTERNAL_SERVICE_TOKEN=replace-with-a-long-random-value

# What review-core advertises to workers as its own address for callbacks (§20.3). Must be resolvable
# FROM the worker containers — a service name under Compose, not localhost.
REVIEW_CORE_BASE_URL=http://review-core:8080

# --- Demo authentication (§33) ---
# No defaults anywhere: a blank value fails startup rather than seeding a guessable password.
DEMO_ADMIN_PASSWORD=
DEMO_STANDARDS_ADMIN_PASSWORD=
DEMO_REVIEWER_PASSWORD=

# --- Published port (§27) ---
# Only review-web is exposed to the host. Every other container stays on the internal network (§3).
DOCREVIEW_HTTP_PORT=8080

# --- Job orchestration bounds (§21, §15.5) ---
# Concurrency caps. retrieval-comparison is lower on purpose: each unit is a chain of LiteLLM calls,
# so its bound is proxy rate limits and budget rather than local CPU (§10.5).
JOB_WORKER_THREADS=2
JOB_MAX_ATTEMPTS=3
JOB_STALE_AFTER=15m
# Cap on requirements evaluated per comparison. Conservative by default: one comparison costs up to
# this many comparison calls PLUS this many embedding calls against a shared proxy.
MAX_REQUIREMENTS_PER_COMPARISON=120
